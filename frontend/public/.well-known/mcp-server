  },
  "last_updated": "2026-09-15T00:00:00Z",
  "cache_ttl": 3600,
  "crawl": true,
  "tools_preview": [
    {
      "name": "list_projects",
      "description": "Read-only listing of Kanban AI projects the authenticated user can access."
    },
    {
      "name": "get_board",
      "description": "Read-only snapshot of one project, including its tasks and comments as JSON."
    },
    {
      "name": "create_project",
      "description": "Create a new Kanban AI project owned by the authenticated user."
    },
    {
      "name": "update_project",
      "description": "Update metadata on a project the authenticated user already belongs to."
    },
    {
      "name": "create_task",
      "description": "Create a task card on a project board the authenticated user already belongs to."
    },
    {
      "name": "update_task",
      "description": "Update fields on an existing task the authenticated user can access."
    },
    {
      "name": "list_task_comments",
      "description": "Read-only listing of comments on a task the authenticated user can access."
    },
    {
      "name": "add_task_comment",
      "description": "Append a comment to a task thread the authenticated user can access."
    }
  ]
}
