    "required": true,
    "methods": ["bearer", "apikey"],
    "endpoint": "https://kanbanai.dev/connect",
    "apikey_header": "X-MCP-API-Key",
    "bearer_description": "Personal MCP key (kai_…) from Connect AI, or a short-lived Supabase session JWT",
    "www_authenticate": "Bearer",
    "resource_metadata": "https://kanbanai.dev/.well-known/oauth-protected-resource"
  },
  "rate_limit": {
    "authenticated": "120 requests per minute",
    "unauthenticated": "30 requests per minute"
  },
  "docs": "https://kanbanai.dev/docs/connect-mcp-claude-cursor",
  "links": {
    "connect": "https://kanbanai.dev/connect",
